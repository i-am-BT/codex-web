# Copy to .env or .env.docker before `docker compose up`.
# Real secrets stay local and are gitignored.

APP_NAME=Codex Web
CODEX_WEB_PASSWORD=replace-with-a-strong-password
SESSION_SECRET=replace-with-at-least-32-random-bytes

# Published port on the host.
CODEX_WEB_PORT=36354
PUBLIC_HOST=127.0.0.1
COOKIE_SECURE=false

# Optional image override after publishing.
CODEX_WEB_IMAGE=ikirito9/codex-web:latest

# Host paths mounted into the container.
CODEX_HOME_HOST=./data/codex
CODEX_WEB_RUNTIME_HOST=./data/runtime
CODEX_WEB_WORKSPACES_HOST=./data/workspaces

# Container defaults. Desktop IPC is unavailable in most container hosts.
CODEX_DESKTOP_IPC_ENABLED=false
CODEX_CONFIG_WRITABLE=false
DEFAULT_CWD=/workspaces
DEFAULT_SANDBOX=workspace-write
DEFAULT_APPROVAL=on-request
NATIVE_SESSION_POLL_MS=1000
TZ=Asia/Shanghai

# Optional quota integrations. Keep real keys only in local env files.
# CPA_QUOTA_BASE_URL=http://host.docker.internal:8327
# CPA_QUOTA_API_KEY=
# SUB2API_BASE_URL=
# SUB2API_API_KEY=
# GROK2API_BASE_URL=http://host.docker.internal:8100
# GROK2API_ADMIN_PASSWORD=
